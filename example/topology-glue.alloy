// Topology tier on the network-snmp fork.
// Hot and cold scrapes forward to otelcol.receiver.prometheus.alloy_snmp.
// The topology scrape stops at prometheus.network_topology, which forwards only the
// reconciled graph (network_topology_device_info / network_topology_edge_info).
// Series whose names are outside the neighbor list are dropped, not passed through.
// Keep hot, cold, and node-exporter scrapes on a different forward_to.

discovery.snmp "lab" {
	auths            = env("SNMP_AUTHS")
	refresh_interval = "15m"
	tiers            = ["hot", "cold", "topology"]

	group {
		name  = "hq"
		cidrs = ["172.20.20.0/24"]
		auths = ["public_v2"]
	}
}

discovery.relabel "snmp_topology" {
	targets = discovery.snmp.lab.targets
	rule {
		source_labels = ["snmp_tier"]
		regex         = "topology"
		action        = "keep"
	}
}

prometheus.exporter.snmp "topology" {
	auths   = env("SNMP_AUTHS")
	targets = discovery.relabel.snmp_topology.output
}

prometheus.scrape "snmp_topology" {
	targets         = prometheus.exporter.snmp.topology.targets
	scrape_interval = "15m"
	scrape_timeout  = "2m"
	forward_to      = [prometheus.network_topology.lab.receiver]
}

// Raw neighbor walks stay here. Only the reconciled graph is forwarded.
prometheus.network_topology "lab" {
	forward_to  = [otelcol.receiver.prometheus.alloy_snmp.receiver]
	stale_after  = "30m"
}
