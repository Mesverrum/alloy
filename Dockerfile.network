# Thin overlay: stock Grafana Alloy + curated SNMP library + snmp-discovery CLI.
# Does NOT include discovery.snmp (that lives in the Alloy binary — use
# Dockerfile.network-src / build-alloy-bin-overlay.sh for the fork).
#
# Library and CLI come from github.com/Mesverrum/snmp-sd.
#
#   docker build -f Dockerfile.network -t srl-local/alloy:network-dev .
ARG SNMP_SD_VERSION=v0.1.0
FROM golang:1.26.6-bookworm AS snmp-sd
ARG SNMP_SD_VERSION
WORKDIR /mod
ENV GOPROXY=https://proxy.golang.org,direct
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod init tmp \
    && CGO_ENABLED=0 go get github.com/Mesverrum/snmp-sd@${SNMP_SD_VERSION} \
    && CGO_ENABLED=0 go install github.com/Mesverrum/snmp-sd/cmd/snmp-discovery@${SNMP_SD_VERSION} \
    && SNMPSD="$(go list -m -f '{{.Dir}}' github.com/Mesverrum/snmp-sd)" \
    && mkdir -p /snmp-lib \
    && cp -a "${SNMPSD}/snmp/." /snmp-lib/

FROM grafana/alloy:latest
COPY --from=snmp-sd /go/bin/snmp-discovery /usr/bin/snmp-discovery
COPY --from=snmp-sd /snmp-lib/ /etc/alloy/
